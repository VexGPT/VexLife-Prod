    ],
    "dataKey": "diagnostics:export:DEBUG_ZIP"
  },
  "workspace.description.diagnostics-enhanced-note": {
    "strings": {
      "en": {
        "text": "Enhanced capture also records process and memory snapshots every 30 seconds for two hours, then stops by itself."
      }
    },
    "surfaces": [
      "workspace.settings"
    ]
  },
  "workspace.description.diagnostics-export-note": {
    "strings": {
      "en": {
        "text": "The ZIP holds states, timings, process IDs, receipt summaries and short log tails. It never includes your conversations, prompts or page contents."
      }
    },
    "surfaces": [
      "workspace.settings"
    ]
  },
  "workspace.description.diagnostics-clear-confirm": {
    "strings": {
      "en": {
        "text": "Clear the debug history? Only this history is removed. Your conversations, memory and Vex Home stay as they are."
      }
    },
    "surfaces": [
      "workspace.settings"
    ],
    "dataKey": "diagnostics:control:CLEAR_HISTORY"
  },
