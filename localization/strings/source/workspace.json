{
  "_meta": {
    "scope": "workspace",
    "category": "product",
    "description": "The VexLife workspace in the browser. English is canonical source; other languages are filled by the translation cycle (see docs/foundation/LOCALIZATION.md).",
    "keyConvention": "workspace.{element-type}.{semantic-name}",
    "surfaces": {
      "workspace.settings": "the Settings panel of the workspace",
      "workspace.conversation": "the conversation column and its composer"
    },
    "dataKeyOwners": {
      "diagnostics": "VexLifeDiagnosticsFamily (state, control refs) and the debug export route",
      "capability": "VexLifeCapabilityBridge uses (handle:action), shown to the person as reach",
      "model": "VexLifeModelsFamily (files, control refs) and HereticModelCatalog standing"
    }
  },
  "workspace.heading.diagnostics": {
    "strings": {
      "en": {
        "text": "Debug & diagnostics"
      }
    },
    "surfaces": [
      "workspace.settings"
    ]
  },
  "workspace.description.diagnostics": {
    "strings": {
      "en": {
        "text": "VexLife keeps a short history of what happened (setup steps, service and model starts, sends and how they ended) so a problem can be traced to its cause. It holds no conversation text."
      }
    },
    "surfaces": [
      "workspace.settings"
    ]
  },
  "workspace.status.diagnostics-recording": {
    "strings": {
      "en": {
        "text": "Trace: recording the normal history"
      }
    },
    "surfaces": [
      "workspace.settings"
    ],
    "dataKey": "diagnostics:state:RECORDING"
  },
  "workspace.status.diagnostics-enhanced-off": {
    "strings": {
